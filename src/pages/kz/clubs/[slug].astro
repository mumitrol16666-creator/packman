---
import ClubPage from '../../../views/ClubPage.astro';
import { branches } from '../../../lib/data.js';

export function getStaticPaths() {
  return branches.map((branch) => ({ params: { slug: branch.slug }, props: { branch } }));
}

const { branch } = Astro.props;
---

<ClubPage branch={branch} lang="kk" />
