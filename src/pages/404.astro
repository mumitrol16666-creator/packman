---
import Base from '../layouts/Base.astro';
import { branches } from '../lib/data.js';
import { ui } from '../i18n/index.js';
import { url } from '../lib/url.js';

// Страница 404 одна на оба языка: сервер не знает, на каком языке искали страницу.
const ru = ui('ru').notFound;
const kk = ui('kk').notFound;
---

<Base title={ru.title} description={ru.description} lang="ru" pagePath="/404/">
  <section class="section lost">
    <div class="wrap">
      <span class="eyebrow">{ru.eyebrow}</span>
      <h1>{ru.h1}</h1>
      <p>{ru.lead}</p>
      <p lang="kk">{kk.lead}</p>
      <div class="lost__actions">
        <a class="btn btn--primary" href={url('/')}>{ru.home}</a>
        <a class="btn btn--primary" href={url('/', 'kk')} lang="kk">{kk.home}</a>
        {branches.map((b) => <a class="btn" href={url(`/clubs/${b.slug}/`)}>{b.name}</a>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .lost .wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    min-height: 50vh;
    justify-content: center;
  }

  .lost h1 {
    font-size: clamp(36px, 8vw, 64px);
    max-width: 16ch;
  }

  .lost p {
    color: var(--muted);
  }

  .lost__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }
</style>
