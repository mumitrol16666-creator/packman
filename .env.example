# --- Сборка сайта (astro build) ---
# Адрес приёма событий. Пусто — сайт ничего не отправляет.
PUBLIC_TRACK_URL=
# Номер счётчика Яндекс Метрики. Пусто — Метрика не подключается.
PUBLIC_METRIKA_ID=
# Домен и подпапка, если сайт живёт не на https://pacman.kz/.
# Эти две читает astro.config.mjs из окружения: SITE_URL=https://example.kz SITE_BASE=/sub npm run build
SITE_URL=
SITE_BASE=

# --- Сервис статистики (npm run server) ---
PORT=8787
DB_PATH=./data/analytics.db
TIMEZONE=Asia/Aqtobe
# Час отправки отчётов по времени клуба
REPORT_HOUR=9
# Токен бота от @BotFather и канал для отчётов (@имя или -100…)
TG_BOT_TOKEN=
TG_REPORT_CHAT_ID=
# Необязательно: чат администраторов для уведомлений о заявках
TG_BOOKINGS_CHAT_ID=
# Необязательно: сайты на другом домене, которым разрешено слать события (через запятую)
ALLOWED_ORIGINS=
# 0 — если сервис смотрит в интернет напрямую, без Caddy или nginx перед ним
TRUST_PROXY=1
SITE_NAME=Pacman Game Center
